{
  "components": {
    "schemas": {
      "CounterfactualOverrides": {
        "additionalProperties": false,
        "properties": {
          "centralization": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Centralization"
          },
          "expansion_pressure": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expansion Pressure"
          },
          "federation_bias": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Federation Bias"
          },
          "ship_velocity_c": {
            "anyOf": [
              {
                "exclusiveMaximum": 0.99,
                "exclusiveMinimum": 0.05,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ship Velocity C"
          }
        },
        "title": "CounterfactualOverrides",
        "type": "object"
      },
      "CounterfactualRequest": {
        "properties": {
          "overrides": {
            "$ref": "#/components/schemas/CounterfactualOverrides"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "snapshot_year": {
            "default": 40,
            "minimum": 0.0,
            "title": "Snapshot Year",
            "type": "integer"
          },
          "steps": {
            "default": 80,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "CounterfactualRequest",
        "type": "object"
      },
      "ExperimentReportRequest": {
        "properties": {
          "kind": {
            "enum": [
              "counterfactual",
              "sweep",
              "sensitivity"
            ],
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "payload"
        ],
        "title": "ExperimentReportRequest",
        "type": "object"
      },
      "ForkSimulationRequest": {
        "properties": {
          "include_snapshots": {
            "default": true,
            "title": "Include Snapshots",
            "type": "boolean"
          },
          "overrides": {
            "$ref": "#/components/schemas/CounterfactualOverrides"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "snapshot_year": {
            "minimum": 0.0,
            "title": "Snapshot Year",
            "type": "integer"
          },
          "steps": {
            "default": 80,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "snapshot_year"
        ],
        "title": "ForkSimulationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MonteCarloRequest": {
        "properties": {
          "scenario": {
            "default": "baseline_empire",
            "title": "Scenario",
            "type": "string"
          },
          "seeds": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 3,
            "title": "Seeds",
            "type": "array"
          },
          "steps": {
            "default": 120,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "MonteCarloRequest",
        "type": "object"
      },
      "RunSimulationRequest": {
        "properties": {
          "include_snapshots": {
            "default": true,
            "title": "Include Snapshots",
            "type": "boolean"
          },
          "scenario": {
            "default": "baseline_empire",
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "steps": {
            "default": 80,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "RunSimulationRequest",
        "type": "object"
      },
      "SensitivityRequest": {
        "properties": {
          "parameters": {
            "items": {
              "enum": [
                "centralization",
                "ship_velocity_c",
                "expansion_pressure",
                "federation_bias"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Parameters",
            "type": "array"
          },
          "perturbation": {
            "default": 0.22,
            "maximum": 0.45,
            "minimum": 0.05,
            "title": "Perturbation",
            "type": "number"
          },
          "scenario": {
            "default": "baseline_empire",
            "title": "Scenario",
            "type": "string"
          },
          "seed_count": {
            "default": 8,
            "maximum": 50.0,
            "minimum": 3.0,
            "title": "Seed Count",
            "type": "integer"
          },
          "seed_start": {
            "default": 200,
            "title": "Seed Start",
            "type": "integer"
          },
          "steps": {
            "default": 120,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "title": "SensitivityRequest",
        "type": "object"
      },
      "StartSimulationRequest": {
        "properties": {
          "scenario": {
            "default": "baseline_empire",
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "StartSimulationRequest",
        "type": "object"
      },
      "StepSimulationRequest": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "steps": {
            "default": 1,
            "maximum": 250.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "StepSimulationRequest",
        "type": "object"
      },
      "SweepRequest": {
        "properties": {
          "include_snapshots": {
            "default": false,
            "title": "Include Snapshots",
            "type": "boolean"
          },
          "parameter": {
            "default": "centralization",
            "enum": [
              "centralization",
              "ship_velocity_c",
              "expansion_pressure",
              "federation_bias"
            ],
            "title": "Parameter",
            "type": "string"
          },
          "scenario": {
            "default": "baseline_empire",
            "title": "Scenario",
            "type": "string"
          },
          "seed": {
            "default": 42,
            "title": "Seed",
            "type": "integer"
          },
          "steps": {
            "default": 120,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "maxItems": 16,
            "minItems": 2,
            "title": "Values",
            "type": "array"
          }
        },
        "title": "SweepRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
